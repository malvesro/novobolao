# Exemplo de configuração de ambiente (Copa 2026)
# Copie este arquivo para .env na raiz do projeto e ajuste conforme necessário.

# MySQL Root Password (Obrigatório para o container db)
MYSQL_ROOT_PASSWORD=root

# MySQL Bolão User & Password
MYSQL_DATABASE=bolao
MYSQL_USER=user_bolao
MYSQL_PASSWORD=pass_bolao

# Configurações de E-mail (Opcional - SMTP corporativo)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=senha
# SMTP_TLS=true
