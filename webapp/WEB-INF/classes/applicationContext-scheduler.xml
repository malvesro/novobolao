<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN"
	"http://www.springframework.org/dtd/spring-beans.dtd">

<beans>

	<!-- Job para avisar que o jogo começa em 2hrs e o participante tem
		mais 1hr para atualizar o palpite -->
	<bean id="avisoJogoJob"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="jogoService" />
		<property name="targetMethod" value="avisarSobreProximoJogo" />
	</bean>
	
	<!-- Trigger que dispara o Job de aviso de jogo às 8:00 -->
	<bean id="avisoJogo10Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 8 ? * MON-FRI" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 9:00 -->
	<bean id="avisoJogo11Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 9 ? * MON-FRI" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 10:00 -->
	<bean id="avisoJogo12Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 10 ? * MON-FRI" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 11:00 -->
	<bean id="avisoJogo13Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 11 ? * MON-FRI" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 13:00 -->
	<bean id="avisoJogo15Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 13 ? * MON-FRI" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 14:00 -->
	<bean id="avisoJogo16Trigger" class="org.springframework.scheduling.quartz.CronTriggerBean">
		<property name="jobDetail">
			<ref local="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 14 ? * MON-FRI" />
	</bean>
	
	<!-- Factory responsável por registrar todas as Triggers -->
	<bean class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="triggers">
			<list>
				<ref local="avisoJogo10Trigger" />
				<ref local="avisoJogo11Trigger" />
				<ref local="avisoJogo12Trigger" />
				<ref local="avisoJogo13Trigger" />
				<ref local="avisoJogo15Trigger" />
				<ref local="avisoJogo16Trigger" />
			</list>
		</property>
	</bean>

</beans>