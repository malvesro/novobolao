<?xml version="1.0" encoding="UTF-8" ?>

<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
    version="2.0">
    
	<description>OpenDev tag library</description>
	<display-name>OpenDev TLD</display-name>
	<tlib-version>1.0</tlib-version>
	<short-name>opendev</short-name>
	<uri>http://www.opendev.com.br/tld</uri>
	
	<tag>
		<description>
		</description>
		<name>portlet</name>
		<tag-class>com.opendev.bolao.taglib.PortletTag</tag-class>
		<body-content>JSP</body-content>
		<attribute>
			<description></description>
			<name>icon</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<description></description>
			<name>id</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
		<attribute>
			<description></description>
			<name>title</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<description></description>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<description></description>
			<name>contentUrl</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<description></description>
			<name>autorefreshRate</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<tag>
		<description>
		</description>
		<name>isIE</name>
		<tag-class>com.opendev.bolao.taglib.IsIETag</tag-class>
		<body-content>JSP</body-content>
	</tag>
	
	<tag>
		<description>
		</description>
		<name>mensagensErro</name>
		<tag-class>com.opendev.bolao.taglib.MensagensErroTag</tag-class>
		<body-content>JSP</body-content>
		<attribute>
			<description></description>
			<name>nomeAtributo</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<function>
		<name>participantesOnline</name>
		<function-class>com.opendev.bolao.util.ContadorParticipantesOnline</function-class>
		<function-signature>int getNumeroDeParticipantesOnline()</function-signature>
	</function>
    
</taglib>