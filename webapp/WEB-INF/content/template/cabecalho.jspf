<!DOCTYPE html PUBLIC
	"-//W3C//DTD XHTML 1.0 Strict//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<%@page contentType="text/html; charset=ISO-8859-1" language="java" %>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@taglib prefix="s" uri="/struts-tags" %>
<%@taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@taglib prefix="opendev" uri="http://www.opendev.com.br/tld" %>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<c:if test="${empty applicationScope.base}">
	<c:choose>
		<c:when test="${pageContext.request.contextPath eq '/'}">
			<c:set var="base" value="" scope="application" />
		</c:when>
		<c:otherwise>
			<c:set var="base" value="${pageContext.request.contextPath}" scope="application" />
		</c:otherwise>
	</c:choose>
</c:if>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1" />
<meta http-equiv="pragma" content="no-cache" />
<title><fmt:message key="app.title" /></title>
<c:if test="${not empty _csrf}">
	<meta name="_csrf" content="${_csrf.token}" />
	<meta name="_csrf_header" content="${_csrf.headerName}" />
	<meta name="_csrf_parameter" content="${_csrf.parameterName}" />
</c:if>
<script type="text/javascript" src="${base}/js/htmx.min.js"></script>
<script type="text/javascript">
	(function () {
		'use strict';
		function getMetaContent(name) {
			var element = document.querySelector('meta[name=\"' + name + '\"]');
			return element ? element.getAttribute('content') : null;
		}

		var token = getMetaContent('_csrf');
		var headerName = getMetaContent('_csrf_header') || 'X-CSRF-TOKEN';
		var parameterName = getMetaContent('_csrf_parameter') || '_csrf';

		if (!token) {
			return;
		}

		function ensureFormToken(form) {
			if (!form || !(form instanceof HTMLFormElement)) {
				return;
			}
			if ((form.method || 'get').toLowerCase() !== 'post') {
				return;
			}
			if (form.querySelector('input[name=\"' + parameterName + '\"]')) {
				return;
			}
			var input = document.createElement('input');
			input.type = 'hidden';
			input.name = parameterName;
			input.value = token;
			form.appendChild(input);
		}

		document.addEventListener('submit', function (event) {
			var form = event.target;
			ensureFormToken(form);
		}, true);

		document.addEventListener('DOMContentLoaded', function () {
			var forms = document.querySelectorAll('form');
			for (var i = 0; i < forms.length; i += 1) {
				ensureFormToken(forms[i]);
			}
		});

		if (window.fetch) {
			var originalFetch = window.fetch.bind(window);
			window.fetch = function (input, init) {
				if (input instanceof Request) {
					var requestHeaders = new Headers(input.headers);
					if (!requestHeaders.has(headerName)) {
						requestHeaders.set(headerName, token);
					}
					var requestInit = Object.assign({}, init || {}, { headers: requestHeaders });
					return originalFetch(new Request(input, requestInit));
				}
				var nextInit = Object.assign({}, init || {});
				var headers = new Headers(nextInit.headers || undefined);
				if (!headers.has(headerName)) {
					headers.set(headerName, token);
				}
				nextInit.headers = headers;
				return originalFetch(input, nextInit);
			};
		}

		if (window.htmx && window.htmx.on) {
			window.htmx.on('htmx:configRequest', function (event) {
				event.detail.headers[headerName] = token;
			});
			window.htmx.on('htmx:afterSwap', function () {
				var forms = document.querySelectorAll('form');
				for (var i = 0; i < forms.length; i += 1) {
					ensureFormToken(forms[i]);
				}
			});
		}
	}());
</script>
<script type="text/javascript">
	window.APP_BASE_URL = '<c:out value="${base}" />';
</script>
<script type="module">
	const BASE_URL = window.APP_BASE_URL || '';

	function buildAssetUrl(path) {
		if (!path) {
			return null;
		}
		if (path.startsWith('http://') || path.startsWith('https://')) {
			return path;
		}
		if (path.startsWith(BASE_URL + '/')) {
			return path;
		}
		if (path.startsWith('/')) {
			return `${BASE_URL}${path}`;
		}
		if (path.startsWith('assets/')) {
			return `${BASE_URL}/${path}`;
		}
		return `${BASE_URL}/assets/${path}`;
	}

	const manifestUrl = buildAssetUrl('assets/manifest.json');
	const fallbackModule = buildAssetUrl('assets/js/app-bundle.js');
	const possibleEntries = [
		'src/frontend/main.js',
		'src/frontend/main.ts',
		'src/frontend/main.jsx',
		'main.js',
		'main.ts',
		'main.jsx'
	];

	async function loadBundle() {
		try {
			const response = await fetch(manifestUrl, { cache: 'no-store' });
			if (response.ok) {
				const manifest = await response.json();
				const entry = possibleEntries
					.map((key) => manifest[key])
					.find((value) => value && value.file);

				if (entry && entry.file) {
					const entryUrl = buildAssetUrl(entry.file);
					if (entryUrl) {
						await import(entryUrl);
						return;
					}
				}
			}
		} catch (error) {
			console.warn('Manifest indisponível, usando bundle fallback.', error);
		}

		if (fallbackModule) {
			await import(fallbackModule);
		} else {
			console.error('Fallback do bundle não encontrado.');
		}
	}

	loadBundle();
</script>


<style type="text/css">
	@IMPORT url("${base}/css/estilo.css");
</style>
</head>
<body>
	<a class="skip-link" href="#content">Ir para o conteúdo principal</a>
	<div id="wrapper">
	<div id="header" role="banner">
	</div>
	<main id="content" role="main" tabindex="-1">
