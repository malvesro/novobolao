<c:url var="successIcon" value="/img/information.gif" />
<c:url var="errorIcon" value="/img/error.gif" />
<c:choose>
    <c:when test="${palpiteAtualizado}">
        <span class="message-inline message-inline--visible message-inline--success">
            <img alt="" src="${successIcon}" class="icon-inline-top" />
            <fmt:message key="match.tip.status.ok" />
        </span>
    </c:when>
    <c:otherwise>
        <span class="message-inline message-inline--visible message-inline--error">
            <img alt="" src="${errorIcon}" class="icon-inline-top" />
            <fmt:message key="match.tip.status.error" />
            <c:if test="${not empty palpiteErro}">
                <span class="message-inline__detail">
                    <c:out value="${palpiteErro}" />
                </span>
            </c:if>
        </span>
    </c:otherwise>
</c:choose>
