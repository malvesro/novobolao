<%--
  Fragmento HTMX: resposta do atualizarPalpitePartial para o redesign "Direct Inline".
  Retorna o <td id="palpite-cell_N"> completo para hx-swap="outerHTML".
  Variáveis esperadas do Action: jogoSelecionado, palpiteSelecionado, palpitePermitido,
    palpiteStatus, palpiteStatusLabel, palpiteAtualizado, palpiteErro, palpiteBloqueioMotivo, _csrf.
--%>
<c:set var="matchId" value="${jogoSelecionado.id}" />
<c:set var="palpiteGols1" value="${palpiteSelecionado != null ? palpiteSelecionado.golsEquipe1 : ''}" />
<c:set var="palpiteGols2" value="${palpiteSelecionado != null ? palpiteSelecionado.golsEquipe2 : ''}" />
<c:url var="atualizarUrl" value="/seguro/atualizarPalpitePartial.action" />
<c:set var="palpiteStatusKey">match.tip.status.${palpiteStatus}</c:set>
<fmt:message key="${palpiteStatusKey}" var="palpiteStatusLabel" />
<fmt:message key="match.tip.none" var="palpiteNoneLabel" />
<fmt:message key="match.tip.state.saving" var="tipSavingLabel" />
<fmt:message key="match.tip.state.saved" var="tipSavedLabel" />
<fmt:message key="match.tip.state.error" var="tipErrorLabel" />
<fmt:message key="match.tip.state.locked" var="tipLockedLabel" />
<fmt:message key="match.tip.state.locked.short" var="tipLockedShortLabel" />
<fmt:message key="general.retry" var="retryLabel" />
<fmt:message key="match.tip.locked.timeWindow" var="tipLockedTimeWindowLabel" />
<fmt:message key="match.tip.locked.adminRestricted" var="tipLockedAdminLabel" />
<fmt:message key="match.tip.locked.roleMissing" var="tipLockedRoleLabel" />
<fmt:message key="match.tip.locked.generic" var="tipLockedGenericLabel" />

<td class="match-table__palpite-cell" id="palpite-cell_${matchId}">

    <%-- Meta-dados para sincronização via JS (sincMatchRowFromCell) --%>
    <span class="sr-only"
          data-palpite-meta="true"
          data-palpite-status="${palpiteStatus}"
          data-palpite-allowed="${palpitePermitido}"
          data-palpite-gols1="${palpiteGols1}"
          data-palpite-gols2="${palpiteGols2}"
          data-palpite-status-label="${palpiteStatusLabel}"
          data-palpite-placeholder="${palpiteNoneLabel}"
          data-palpite-locked-reason="${palpiteBloqueioMotivo}"
          aria-hidden="true"></span>

    <c:choose>
        <%-- Janela ainda aberta: exibir inputs + feedback de resultado --%>
        <c:when test="${palpitePermitido}">

            <c:choose>
                <%-- Feedback de sucesso —  "✓ Salvo HH:MM" --%>
                <c:when test="${palpiteAtualizado}">
                    <jsp:useBean id="agora" class="java.util.Date" />
                    <fmt:formatDate value="${agora}" pattern="HH:mm" var="horaSalvo" />
                    <span id="palpite-feedback_${matchId}" class="palpite-cell-feedback palpite-cell-feedback--saved" aria-live="polite">
                        ${tipSavedLabel} ${horaSalvo}
                    </span>
                </c:when>

                <%-- Feedback de erro HTTP (ex.: validação backend) --%>
                <c:when test="${not empty palpiteErro}">
                    <span id="palpite-feedback_${matchId}" class="palpite-cell-feedback palpite-cell-feedback--error" aria-live="polite">
                        ${tipErrorLabel}
                        <c:out value="${palpiteErro}" />
                    </span>
                    <button type="button"
                            class="button button-ghost palpite-cell-retry"
                            data-js="retry-palpite"
                            data-jogo-id="${matchId}">
                        ${retryLabel}
                    </button>
                </c:when>

                <c:otherwise>
                    <span id="palpite-feedback_${matchId}" class="palpite-cell-feedback" aria-live="polite"></span>
                </c:otherwise>
            </c:choose>
        </c:when>

        <%-- Janela fechada: exibir placar + badge --%>
        <c:otherwise>
            <span id="palpite-feedback_${matchId}" class="palpite-cell-feedback palpite-cell-feedback--locked" aria-live="polite">${tipLockedShortLabel}</span>
            <c:choose>
                <c:when test="${palpiteSelecionado != null}">
                    <span class="palpite-saved-score" aria-label="Meu palpite">
                        <c:out value="${palpiteGols1}" /> x <c:out value="${palpiteGols2}" />
                    </span>
                </c:when>
                <c:otherwise>
                    <span class="palpite-placeholder">${palpiteNoneLabel}</span>
                </c:otherwise>
            </c:choose>
            <c:choose>
                <c:when test="${palpiteBloqueioMotivo eq 'timeWindow'}">
                    <span class="palpite-locked-msg" aria-label="Prazo encerrado">${tipLockedTimeWindowLabel}</span>
                </c:when>
                <c:when test="${palpiteBloqueioMotivo eq 'adminRestricted'}">
                    <span class="palpite-locked-msg" aria-label="Perfil administrador bloqueado">${tipLockedAdminLabel}</span>
                </c:when>
                <c:when test="${palpiteBloqueioMotivo eq 'roleMissing'}">
                    <span class="palpite-locked-msg" aria-label="Perfil sem permissão">${tipLockedRoleLabel}</span>
                </c:when>
                <c:otherwise>
                    <span class="palpite-locked-msg" aria-label="Palpite indisponível">${tipLockedGenericLabel}</span>
                </c:otherwise>
            </c:choose>
        </c:otherwise>
    </c:choose>
</td>
