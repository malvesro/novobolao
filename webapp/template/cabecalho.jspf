<!DOCTYPE html PUBLIC
	"-//W3C//DTD XHTML 1.0 Strict//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<%@page contentType="text/html; charset=ISO-8859-1" language="java" %>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@taglib prefix="s" uri="/struts-tags" %>
<%@taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@taglib prefix="opendev" uri="http://www.opendev.com.br/tld" %>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<c:if test="${empty applicationScope.base}">
	<c:choose>
		<c:when test="${pageContext.request.contextPath eq '/'}">
			<c:set var="base" value="" scope="application" />
		</c:when>
		<c:otherwise>
			<c:set var="base" value="${pageContext.request.contextPath}" scope="application" />
		</c:otherwise>
	</c:choose>
</c:if>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1" />
<meta http-equiv="pragma" content="no-cache" />
<title><fmt:message key="app.title" /></title>
<script type="text/javascript" src="${base}/js/BrowserDetector.js"></script>
<script type="text/javascript" src="${base}/js/prototype.js"></script>
<script type="text/javascript" src="${base}/js/scriptaculous.js"></script>
<script type="text/javascript" src="${base}/js/effects.js"></script>
<script type="text/javascript" src="${base}/js/engine.js"></script>
<script type="text/javascript" src="${base}/js/util.js"></script>
<script type="text/javascript" src="${base}/js/overlib.js"></script>
<script type="text/javascript" src="${base}/js/jquery-4.0.0.min.js"></script>
<script type="text/javascript" src="${base}/js/htmx.min.js"></script>

<script type="text/javascript">
	// jQuery noConflict mode to avoid collisions with Prototype's $
	var $j = jQuery.noConflict();
</script>


<style type="text/css">
	@IMPORT url("${base}/css/estilo.css");
</style>
</head>
<body>
	<div id="wrapper">
	<div id="header">
	</div>
	<div id="content">
