# Credenciais do banco de dados (substitua por valores seguros antes de subir os containers)
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=bolao
MYSQL_USER=user_bolao
MYSQL_PASSWORD=troque-esta-senha-app

# Variáveis consumidas pela aplicação
DB_HOST=db
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
