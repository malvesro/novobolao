<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:security="http://www.springframework.org/schema/security"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/security
           http://www.springframework.org/schema/security/spring-security.xsd">

	<!-- Spring Security 6 Configuration -->

    <!-- Global Method Security -->
    <security:global-method-security secured-annotations="enabled" pre-post-annotations="enabled">
        <security:protect-pointcut expression="execution(* com.opendev.bolao.action.AdminAction.carregarInfoEquipes(..))" access="hasRole('ADMIN')" />
        <security:protect-pointcut expression="execution(* com.opendev.bolao.action.AdminAction.criarNovoJogo(..))" access="hasRole('ADMIN')" />
        <security:protect-pointcut expression="execution(* com.opendev.bolao.action.AdminAction.atualizarResultadoDoJogo(..))" access="hasRole('ADMIN')" />
    </security:global-method-security>

    <!-- HTTP Security Configuration -->
    <security:http auto-config="false" use-expressions="true">
        
        <!-- Intercept URLs -->
        <!-- Note: patterns are matched in order, most specific first -->
        <security:intercept-url pattern="/login.jsp*" access="permitAll" />
        <security:intercept-url pattern="/admin/**" access="hasRole('ADMIN')" />
        <security:intercept-url pattern="/dwr/index.html" access="hasRole('ADMIN')" />
        <security:intercept-url pattern="/dwr/test/**" access="hasRole('ADMIN')" />
        <security:intercept-url pattern="/dwr/**" access="hasAnyRole('ADMIN', 'USER')" />
        <security:intercept-url pattern="/seguro/jogos.jsp" access="hasAnyRole('ADMIN', 'USER')" />
        <security:intercept-url pattern="/seguro/**" access="hasAnyRole('ADMIN', 'USER')" />
        
        <!-- Public Resources -->
        <security:intercept-url pattern="/css/**" access="permitAll" />
        <security:intercept-url pattern="/js/**" access="permitAll" />
        <security:intercept-url pattern="/img/**" access="permitAll" />
        <security:intercept-url pattern="/fx/**" access="permitAll" />
        <security:intercept-url pattern="/index.jsp" access="permitAll" />
        <security:intercept-url pattern="/" access="permitAll" />

        <!-- Form Login Configuration -->
        <security:form-login 
            login-page="/login.jsp" 
            authentication-failure-url="/login.jsp?status=invalido"
            default-target-url="/seguro/principal.jsp"
            login-processing-url="/j_security_check"
            username-parameter="j_username"
            password-parameter="j_password" />

        <!-- Logout Configuration -->
        <security:logout 
            logout-url="/j_logout"
            logout-success-url="/login.jsp" 
            invalidate-session="true"
            delete-cookies="JSESSIONID" />
        
        <!-- Anonymous Access -->
        <security:anonymous key="anonymous" granted-authority="ROLE_ANONYMOUS" />
        
        <!-- Session Management -->
        <security:session-management session-fixation-protection="migrateSession" />

        <!-- CSRF disabled for legacy frontend compatibility (Prototype.js/Scriptaculous) -->
        <security:csrf disabled="true"/>
        
        <!-- Security Headers -->
        <security:headers>
            <security:frame-options policy="SAMEORIGIN" />
        </security:headers>

    </security:http>

    <!-- Authentication Manager -->
    <security:authentication-manager id="authenticationManager">
        <security:authentication-provider user-service-ref="jdbcUserService">
            <security:password-encoder ref="passwordEncoder" />
        </security:authentication-provider>
    </security:authentication-manager>

    <!-- JDBC User Service -->
    <security:jdbc-user-service id="jdbcUserService" 
        data-source-ref="defaultDataSource"
        users-by-username-query="select PAR_LOGIN, PAR_SENHA, case when PAR_HABILITADO = 'T' then true else false end as enabled from PAR_PARTICIPANTE where PAR_LOGIN = ?"
        authorities-by-username-query="select par.PAR_LOGIN, pri.PRI_PAPEL from PRI_PRIVILEGIO as pri inner join PAR_PARTICIPANTE as par where par.PAR_LOGIN = ? and par.PAR_ID = pri.PRI_PAR_ID" />

    <!-- Password Encoders -->
    <bean id="bcryptEncoder" class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder" />
    <bean id="sha1Encoder" class="com.opendev.bolao.util.LegacySha1PasswordEncoder" />
    
    <!-- DelegatingPasswordEncoder for seamless migration of existing users -->
    <bean id="passwordEncoder" class="com.opendev.bolao.util.DelegatingPasswordEncoder">
        <constructor-arg index="0" value="bcrypt" />
        <constructor-arg index="1">
            <map>
                <entry key="bcrypt" value-ref="bcryptEncoder" />
                <entry key="sha1" value-ref="sha1Encoder" />
            </map>
        </constructor-arg>
    </bean>

    <!-- Logger Listener for security events -->
    <bean id="loggerListener" class="org.springframework.security.authentication.event.LoggerListener" />

</beans>
