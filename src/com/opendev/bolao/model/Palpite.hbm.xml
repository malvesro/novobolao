<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.opendev.bolao.model">

	<class name="Palpite" table="PAL_PALPITE" lazy="true">

		<composite-id>
			<key-property name="idParticipante" column="PAL_PAR_ID" />
			<key-property name="idJogo" column="PAL_JOG_ID" />
		</composite-id>

		<property name="golsEquipe1" column="PAL_EQP1_GOLS" not-null="true" />
		<property name="golsEquipe2" column="PAL_EQP2_GOLS" not-null="true" />
		<property name="ip" column="PAL_IP" not-null="true" />
		<property name="dataHoraAtualizacao" column="PAL_DH_ATUALIZACAO" not-null="true" type="timestamp" />
		
		<many-to-one name="participante" class="Participante" column="PAL_PAR_ID" insert="false" update="false" />
		<many-to-one name="jogo" class="Jogo" column="PAL_JOG_ID" insert="false" update="false" />

	</class>

</hibernate-mapping>