<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.opendev.bolao.model">

	<class name="PalpiteBolaoIndividual" table="PAI_PALPITE_INDIVIDUAL" lazy="true">

		<composite-id>
			<key-property name="participanteId" column="PAI_PAR_ID" />
			<key-property name="bolaoIndividualId" column="PAI_BOI_ID" />
		</composite-id>

		<property name="golsEquipe1" column="PAI_EQP1_GOLS" not-null="true" />
		<property name="golsEquipe2" column="PAI_EQP2_GOLS" not-null="true" />
		<property name="ip" column="PAL_IP" not-null="true" />
		<property name="pago" column="PAI_PAR_PAGO" not-null="true" type="boolean" />
		<property name="dataHoraPagamento" column="PAI_DH_PAGTO" not-null="true" type="timestamp" />
		
		<many-to-one name="participante" class="Participante" column="PAI_PAR_ID" insert="false" update="false" />
		<many-to-one name="bolaoIndividual" class="BolaoIndividual" column="PAI_BOI_ID" insert="false" update="false" />

	</class>

</hibernate-mapping>