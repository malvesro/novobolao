<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Job para avisar que o jogo começa em 2hrs e o participante tem
		mais 1hr para atualizar o palpite -->
	<bean id="avisoJogoJob"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="jogoService" />
		<property name="targetMethod" value="avisarSobreProximoJogo" />
	</bean>
	
	<!-- Trigger que dispara o Job de aviso de jogo às 8:00 -->
	<bean id="avisoJogo10Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 8 ? * MON-FRI" />
		<!-- Não herdar timezone do host/JVM (importante em produção no HF). -->
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 9:00 -->
	<bean id="avisoJogo11Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 9 ? * MON-FRI" />
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 10:00 -->
	<bean id="avisoJogo12Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 10 ? * MON-FRI" />
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 11:00 -->
	<bean id="avisoJogo13Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 11 ? * MON-FRI" />
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 13:00 -->
	<bean id="avisoJogo15Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 13 ? * MON-FRI" />
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	<!-- Trigger que dispara o Job de aviso de jogo às 14:00 -->
	<bean id="avisoJogo16Trigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail">
			<ref bean="avisoJogoJob" />
		</property>
		<property name="cronExpression" value="0 0 14 ? * MON-FRI" />
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>
	
	<!-- Job para polling de scores em tempo real -->
	<bean id="liveScoreJobDetail" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="liveScorePollerJob" />
		<property name="targetMethod" value="execute" />
	</bean>

	<bean id="liveScoreTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="liveScoreJobDetail" />
		<property name="cronExpression" value="0 * * * * ?" /> <!-- A cada minuto -->
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>

	<!-- Job para sincronização de agenda -->
	<bean id="fixtureRefreshJobDetail" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="fixtureRefreshJob" />
		<property name="targetMethod" value="execute" />
	</bean>

	<bean id="fixtureRefreshTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="fixtureRefreshJobDetail" />
		<property name="cronExpression" value="0/30 * * * * ?" /> <!-- A cada 30 segundos para teste local -->
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>

	<!-- Factory responsável por registrar todas as Triggers -->
	<bean class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="triggers">
			<list>
				<ref bean="avisoJogo10Trigger" />
				<ref bean="avisoJogo11Trigger" />
				<ref bean="avisoJogo12Trigger" />
				<ref bean="avisoJogo13Trigger" />
				<ref bean="avisoJogo15Trigger" />
				<ref bean="avisoJogo16Trigger" />
				<ref bean="liveScoreTrigger" />
				<ref bean="fixtureRefreshTrigger" />
				<ref bean="pastResultsAuditTrigger" />
			</list>
		</property>
	</bean>

	<!-- Auditoria Diária de Resultados Passados -->
	<bean id="pastResultsAuditJobDetail" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="pastResultsAuditJob" />
		<property name="targetMethod" value="execute" />
	</bean>

	<bean id="pastResultsAuditTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="pastResultsAuditJobDetail" />
		<property name="cronExpression" value="0/30 * * * * ?" /> <!-- A cada 30 segundos para teste local -->
		<property name="timeZone" value="America/Sao_Paulo" />
	</bean>

</beans>
