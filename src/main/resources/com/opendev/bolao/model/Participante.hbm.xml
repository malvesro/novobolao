<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.opendev.bolao.model">

	<class name="Participante" table="PAR_PARTICIPANTE" lazy="true">

		<id name="id" column="PAR_ID">
			<generator class="increment" />
		</id>
		
		<property name="nome" column="PAR_NOME" not-null="true" />
		<property name="login" column="PAR_LOGIN" not-null="true" />
		<property name="senha" column="PAR_SENHA" not-null="true" />
		<property name="email" column="PAR_EMAIL" not-null="true" />
		<property name="habilitado" column="PAR_HABILITADO" type="true_false" not-null="true" />
		<property name="ip" column="PAR_IP" not-null="true" />
		<property name="dataHoraCadastro" column="PAR_DH_CADASTRO" type="timestamp" not-null="true" />

		<set name="privilegios" inverse="true" cascade="all" lazy="true">
			<key column="PRI_PAR_ID" />
			<one-to-many class="Privilegio" />
		</set>
		
		<set name="palpites" inverse="true" cascade="delete" lazy="true">
			<key column="PAL_PAR_ID" />
			<one-to-many class="Palpite" />
		</set>

	</class>

</hibernate-mapping>