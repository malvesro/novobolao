<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
	"https://struts.apache.org/dtds/struts-2.5.dtd">

<struts>
	<constant name="struts.devMode" value="false" />
	<constant name="struts.objectFactory" value="spring" />

	<!-- Endurecimento de Segurança (Struts 7) -->
	<constant name="struts.ognl.expressionMaxLength" value="200" />
	<constant name="struts.allowlist.enable" value="true" />
	<constant name="struts.allowlist.packageNames" value="com.opendev.bolao.model, com.opendev.bolao.util" />
	<constant name="struts.ognl.excludedNodeTypes" value="ognl.ASTThisVarRef, ognl.ASTVarRef" />

	<package name="bolao-default" extends="struts-default">
		
		<interceptors>
			<interceptor-stack name="bolaoStack">
				<!-- Proteções Cross-Origin modernas -->
				<interceptor-ref name="coop" />
				<interceptor-ref name="coep" />
				<interceptor-ref name="fetchMetadata" />
				<interceptor-ref name="defaultStack" />
			</interceptor-stack>
		</interceptors>

		<default-interceptor-ref name="bolaoStack" />

		<action name="logout" class="participanteAction" method="logout">
			<result name="success">/login.jsp</result>
		</action>
		
		<action name="cadastro" class="participanteAction" method="cadastrar">
			<result name="success">/cadastro.jsp</result>
			<result name="input">/cadastro.jsp</result>
		</action>
		
	</package>
	
	<package name="seguro" extends="bolao-default" namespace="/seguro">
		<action name="ranking" class="participanteAction" method="buscarParticipantes">
			<result name="success">/seguro/classificacao.jsp</result>
		</action>

		<action name="palpites" class="participanteAction" method="prepararInfoPalpites">
			<result name="success">/seguro/jogos.jsp</result>
		</action>
		
		<action name="graficoDesempenho" class="participanteAction" method="gerarGraficoDesempenho">
			<result name="success">/seguro/graficoDesempenho.jsp</result>
		</action>

		<action name="graficoDesempenhoImagem" class="participanteAction" method="gerarGraficoDesempenhoImagem">
			<result type="stream">
				<param name="contentType">image/png</param>
				<param name="inputName">graficoStream</param>
			</result>
		</action>
		
		<action name="copa" class="participanteAction" method="gerarClassificacaoDaCopa">
			<result name="success">/seguro/copa.jsp</result>
		</action>
		
		<action name="principal" class="participanteAction" method="obterDadosPaginaPrincipal">
			<result name="success">/seguro/principal.jsp</result>
		</action>

		<action name="graficoLiderancaImagem" class="participanteAction" method="gerarGraficoLiderancaImagem">
			<result type="stream">
				<param name="contentType">image/png</param>
				<param name="inputName">graficoStream</param>
			</result>
		</action>

	</package>
	
	<package name="admin" extends="bolao-default" namespace="/admin">
	
		<action name="infoEquipes" class="adminAction" method="carregarInfoEquipes">
			<result name="success">/admin/inclusaoJogo.jsp</result>
		</action>
		
		<action name="jogos" class="adminAction" method="carregarJogos">
			<result name="success">/seguro/jogos.jsp</result>
		</action>
		
		<action name="participantes" class="adminAction" method="carregarParticipantes">
			<result name="success">/admin/participantes.jsp</result>
		</action>

		<!-- HTMX PoC: Apagar participante sem recarregar a tela e sem DWR -->
		<action name="apagarParticipanteHtmx" class="adminAction" method="apagarParticipante">
			<result name="success">/admin/empty.jsp</result>
		</action>
	
	</package>

</struts>
